<Project>
  <!-- Gilt für jedes Projekt unter diesem Ordner: einmal hier statt in jeder csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Neue Sicherheitsmeldungen zu Paketen (NuGet-Audit) bleiben Warnungen: Sie sollen auffallen, aber nicht über Nacht jeden Build brechen. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
