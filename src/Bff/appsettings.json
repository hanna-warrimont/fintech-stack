{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "instruments": {
        "ClusterId": "instrument",
        // Nur lesen: Stammdaten werden (noch) nicht über die UI gepflegt.
        "Match": { "Path": "/api/instruments/{**rest}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "corporate-actions": {
        "ClusterId": "instrument",
        // Alle Methoden: Das BFF hängt das Access Token an, der Instrument-Service prüft die Rollen.
        "Match": { "Path": "/api/corporate-actions/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "search": {
        "ClusterId": "search",
        "Match": { "Path": "/api/search/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "history": {
        "ClusterId": "history",
        "Match": { "Path": "/api/history/{**rest}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "quotes": {
        "ClusterId": "quote",
        "Match": { "Path": "/api/quotes/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      // ActivityTimeout 5 s: Ist ein Dienst weg, antwortet das BFF schnell mit 504 statt erst nach YARPs Standard von 100 s.
      // Nicht für "quote": Dort laufen SSE-Streams (die Zeit zählt zwischen zwei Daten-Paketen, bei Ticks alle 500 ms unkritisch).
      "instrument": {
        "Destinations": { "d1": { "Address": "http://instrument" } },
        "HttpRequest": { "ActivityTimeout": "00:00:05" }
      },
      "search": {
        "Destinations": { "d1": { "Address": "http://search" } },
        "HttpRequest": { "ActivityTimeout": "00:00:05" }
      },
      "history": {
        "Destinations": { "d1": { "Address": "http://history" } },
        "HttpRequest": { "ActivityTimeout": "00:00:05" }
      },
      "quote": {
        "Destinations": { "d1": { "Address": "http://quote" } }
      }
    }
  }
}
