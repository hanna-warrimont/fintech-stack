{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "instruments": {
        "ClusterId": "instrument",
        "Match": { "Path": "/api/instruments/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "search": {
        "ClusterId": "search",
        "Match": { "Path": "/api/search/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "quotes": {
        "ClusterId": "quote",
        "Match": { "Path": "/api/quotes/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "instrument": {
        "Destinations": { "d1": { "Address": "http://instrument" } }
      },
      "search": {
        "Destinations": { "d1": { "Address": "http://search" } }
      },
      "quote": {
        "Destinations": { "d1": { "Address": "http://quote" } }
      }
    }
  }
}
